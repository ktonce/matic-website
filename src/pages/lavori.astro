---
import Base from '../layouts/Base.astro';
import Filters from '../components/Filters.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import CTA from '../components/CTA.astro';
import { works, categories } from '../data/works.js';
---
<Base path="/lavori">

  <section id="top" class="page-hero">
    <div class="container">
      <span class="eyebrow">LAVORI REALIZZATI</span>
      <h1 class="page-hero__h1">Il nostro lavoro si vede.</h1>
      <p class="page-hero__lead">Una selezione di insegne, decorazioni, allestimenti e progetti realizzati da MATIC.</p>
    </div>
  </section>

  <section id="lavori" class="section section--light">
    <div class="container">
      <Filters categories={categories()} />
      <PortfolioGrid items={works} showLinks={true} headingLevel="h2" />
      <p class="works__note">Stiamo aggiornando questa raccolta con le fotografie dei lavori più recenti.</p>
    </div>
  </section>

  <CTA
    heading="Hai un progetto simile?"
    text="Raccontaci cosa ti serve. Progettiamo, produciamo e installiamo dal nostro laboratorio di Fucecchio, in Toscana e in tutta Italia."
  />

  <Lightbox slot="after" />
</Base>

<style>
  .page-hero { background: var(--dark); padding: 148px var(--pad-x) 96px; }
  .page-hero__h1 { font: 500 var(--fs-h1)/1.02 var(--font-display); color: var(--offwhite); margin: 0; letter-spacing: -.015em; }
  .page-hero__lead { font: 400 var(--fs-lead)/1.7 var(--font-body); color: var(--grey-400); max-width: 560px; margin: 26px 0 0; }
  @media (max-width: 899px) { .page-hero { padding: 104px clamp(20px,5vw,40px) 56px; } }
  .works__note { font: 400 13.5px/1.7 var(--font-body); color: var(--grey-500); margin: clamp(32px,4vw,48px) 0 0; max-width: 560px; }
</style>
