---
import '../styles/service.css';
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import Lightbox from '../components/Lightbox.astro';
import { site, waLink } from '../data/site.js';
import { servizi, allestimenti as d } from '../data/services.js';
---
<Base path="/allestimenti" ctaHref="#preventivo" ctaLabel="Parlaci del tuo progetto" waText={d.waText} stickyCtaHref="#preventivo">

  {/* ── HERO — TODO FOTO: manca la foto reale di un allestimento ─────────── */}
  <section id="top" class="al-hero">
    <div class="container">
      <span class="eyebrow">{d.hero.eyebrow}</span>
      <div class="al-hero__grid">
        <h1 class="al-hero__h1">{d.hero.h1}</h1>
        <div>
          <p class="al-hero__lead">{d.hero.lead}</p>
          <div class="btn-row">
            <a class="btn btn--primary" href="#preventivo">{d.hero.ctaLabel}</a>
            <a class="btn btn--ghost-dark" href={d.hero.secondaryHref}>{d.hero.secondaryLabel}</a>
          </div>
        </div>
      </div>
      <div class="al-hero__facts">
        {d.hero.facts.map((f, i) => (
          <>
            {i > 0 && <span class="svc-hero__sep">·</span>}
            <span class="svc-hero__fact">{f}</span>
          </>
        ))}
      </div>
    </div>
  </section>

  {/* ── AMBITI ───────────────────────────────────────────────────────────── */}
  <section id="ambiti" class="section section--light al-ambiti">
    <div class="container">
      <div class="split split--end">
        <div>
          <span class="eyebrow eyebrow--accent">{d.ambitiHead.eyebrow}</span>
          <h2 class="svc-h2-mid">{d.ambitiHead.h2}</h2>
        </div>
        <p class="svc-muted">{d.ambitiHead.lead}</p>
      </div>
      <div class="al-ambiti__grid">
        {d.ambiti.map((a) => (
          <article class="al-ambito">
            <h3 class="al-ambito__title">{a.title}</h3>
            <p class="al-ambito__desc">{a.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/*
    CASE STUDY — non renderizzato: `caseStudyBlocks` e `caseStudyPhotos` sono vuoti.
    TODO FOTO: serve un progetto reale documentato da 4-8 fotografie dello stesso
    intervento, più contesto, esigenza e interventi eseguiti.
  */}
  {d.caseStudyBlocks.length > 0 && d.caseStudyPhotos.length > 0 && (
    <section id="case-study" class="section--dark al-case">
      <div class="container">
        <span class="eyebrow">CASE STUDY</span>
        <h2 class="al-case__h2">Un progetto, più elementi coordinati.</h2>
        <div class="al-case__blocks">
          {d.caseStudyBlocks.map((cb) => (
            <div>
              <h3 class="al-case__label">{cb.label}</h3>
              <p class="al-case__text">{cb.text}</p>
            </div>
          ))}
        </div>
        <div class="al-case__gallery">
          {d.caseStudyPhotos.map((cp) => (
            <div class="al-case__photo"><img src={cp.image} alt={cp.alt} loading="lazy" decoding="async" /></div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ── PORTFOLIO — un solo lavoro reale, nessun nome cliente ────────────── */}
  <section id="lavori" class="section section--light al-lavori">
    <div class="container bordered-top">
      <div class="split split--end">
        <div>
          <span class="eyebrow eyebrow--accent">{d.portfolioHead.eyebrow}</span>
          <h2 class="al-h2-mid">{d.portfolioHead.h2}</h2>
        </div>
        <a class="works__all" href="/lavori">{d.portfolioHead.link}</a>
      </div>

      <div class={d.lavori.length > 1 ? 'al-works' : 'al-works al-works--single'}>
        {d.lavori.map((l) => (
          <article
            class="ins-work"
            data-work data-cat="Allestimenti"
            data-img={l.img} data-alt={l.alt} data-tag={l.tipologia} data-title={l.title}
          >
            <button class="work__btn" data-work-open type="button" aria-label={'Ingrandisci: ' + l.title}>
              <span class="ins-work__img" style={'aspect-ratio:' + l.ratio}>
                <img src={l.img} alt={l.alt} loading="lazy" decoding="async" />
              </span>
            </button>
            <div class="ins-work__body">
              <span class="ins-work__tag">{l.tipologia}</span>
              <h3 class="ins-work__title">{l.title}</h3>
              {[l.localita, l.cliente].filter(Boolean).length > 0 && (
                <span class="ins-work__meta">{[l.localita, l.cliente].filter(Boolean).join(' · ').toUpperCase()}</span>
              )}
            </div>
          </article>
        ))}
      </div>
      <p class="prod-nota">{d.portfolioNota}</p>
    </div>
  </section>

  {/* ── COSA COORDINIAMO ─────────────────────────────────────────────────── */}
  <section id="coordiniamo" class="section--dark al-coord">
    <div class="container">
      <div class="split split--file al-coord__head">
        <h2 class="al-coord__h2">{d.coordiniamo.h2}</h2>
        <p class="svc-territorio__text">{d.coordiniamo.lead}</p>
      </div>
      <div class="al-coord__links">
        {d.coordiniamo.links.map((c) => (
          <a href={c.href}>{c.title}<span aria-hidden="true">→</span></a>
        ))}
      </div>
    </div>
  </section>

  {/* ── PROCESSO — montaggio con mezzi propri, assistenza inclusa ────────── */}
  <section id="processo" class="section--dark al-processo">
    <div class="container bordered-top-light">
      <h2 class="svc-h2-light al-processo__h2">{d.processoH2}</h2>
      <ol class="svc-steps al-steps">
        {d.steps.map((st) => (
          <li class="svc-step">
            <span class="svc-step__num">{st.num}</span>
            <h3 class="svc-step__title">{st.title}</h3>
            <p class="svc-step__desc">{st.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ── PERCHÉ MATIC ─────────────────────────────────────────────────────── */}
  <section id="perche" class="section section--light">
    <div class="container">
      <h2 class="al-h2">{d.percheH2}</h2>
      <div class="al-perks">
        {d.perks.map((p) => (
          <div>
            <span class="vt-perk__num">{p.num}</span>
            <h3 class="vt-perk__title">{p.title}</h3>
            <p class="vt-perk__desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── CTA INTERMEDIA ───────────────────────────────────────────────────── */}
  <section class="wa-band">
    <div class="container wa-band__inner">
      <div style="max-width:560px">
        <h2 class="wa-band__h2">{d.ctaIntermedia.h2}</h2>
        <p class="wa-band__text">{d.ctaIntermedia.text}</p>
      </div>
      <div class="btn-row">
        <a class="wa-band__cta" href="#preventivo">{d.ctaIntermedia.primary}</a>
        <a class="wa-band__cta wa-band__cta--ghost" href={waLink(d.waText)} target="_blank" rel="noopener">{d.ctaIntermedia.secondary}</a>
      </div>
    </div>
  </section>

  {/* ── CTA FINALE + FORM ────────────────────────────────────────────────── */}
  <section id="preventivo" class="section section--light">
    <div class="container">
      <div class="form-head form-head--wide">
        <h2 class="form-head__h2">{d.form.h2}</h2>
        <p class="form-head__lead">{d.form.lead}</p>
      </div>
      <div id="form" class="svc-form-grid">
        <div>
          <LeadForm
            formId="preventivo-allestimenti"
            servizio="Allestimenti"
            servizi={servizi}
            extra={d.form.extra}
            aziendaLabel={d.form.aziendaLabel}
            submitLabel={d.form.submitLabel}
            waText={d.waText}
          />
        </div>
        <aside class="contatti-aside">
          <div class="aside__label">OPPURE SCRIVICI SUBITO</div>
          <div class="aside__actions">
            <a class="btn btn--primary" href={waLink(d.waText)} target="_blank" rel="noopener" style="text-align:center">Scrivici su WhatsApp</a>
            <a class="btn btn--ghost-light" href={site.tel.href} style="text-align:center">Chiama lo {site.tel.display}</a>
            <a class="btn" href={site.email.href} style="color:var(--offwhite);background:var(--dark);text-align:center">Scrivici una email</a>
          </div>
          <div class="aside__sede">
            <div class="aside__label">LA NOSTRA SEDE</div>
            <p class="aside__name">MATIC</p>
            <p class="aside__addr">{site.address.street}<br />{site.address.zip} {site.address.city} ({site.address.province})</p>
            <a class="aside__maps" href={site.maps} target="_blank" rel="noopener">Apri su Google Maps</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* ── FAQ ──────────────────────────────────────────────────────────────── */}
  <section id="faq" class="section section--light" style="padding-top:0">
    <div class="container bordered-top split">
      <div>
        <span class="eyebrow eyebrow--accent">{d.faqHead.eyebrow}</span>
        <h2 class="svc-h2-light svc-h2-light--dark">{d.faqHead.h2}</h2>
      </div>
      <div class="faq">
        {d.faqs.map((f) => (
          <details>
            <summary>{f.q}<span class="faq__plus" aria-hidden="true">+</span></summary>
            <p class="faq__answer">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ── TERRITORIO + CROSS-SELL ──────────────────────────────────────────── */}
  <section id="territorio" class="section--dark al-territorio">
    <div class="container">
      <div class="split split--file">
        <h2 class="svc-h2-light">{d.territorio.h2}</h2>
        <p class="svc-territorio__text">{d.territorio.text}</p>
      </div>
      <div class="container bordered-top-light split split--file al-cross">
        <h2 class="vt-cross__h2">{d.cross.h2}</h2>
        <div class="svc-cross">
          {d.cross.links.map((l) => <a href={l.href}>{l.label}<span aria-hidden="true">→</span></a>)}
        </div>
      </div>
    </div>
  </section>

  <Lightbox slot="after" />
</Base>

<style>
  .al-hero { background: var(--dark); padding: 132px var(--pad-x) 96px; }
  @media (max-width: 899px) { .al-hero { padding: 104px clamp(20px,5vw,40px) 56px; } }
  .al-hero__grid { display: grid; grid-template-columns: minmax(320px,1.15fr) minmax(280px,.85fr); gap: clamp(24px,4vw,72px); align-items: end; }
  @media (max-width: 899px) { .al-hero__grid { grid-template-columns: 1fr; } }
  .al-hero__h1 { font: 500 clamp(32px,5vw,70px)/1.03 var(--font-display); color: var(--offwhite); margin: 0; letter-spacing: -.015em; text-wrap: pretty; }
  .al-hero__lead { font: 400 var(--fs-lead)/1.7 var(--font-body); color: var(--grey-400); margin: 0 0 28px; max-width: 460px; }
  .al-hero__facts { margin-top: clamp(32px,4.5vw,56px); padding-top: clamp(26px,3.5vw,42px); border-top: 1px solid var(--line-light); display: flex; flex-wrap: wrap; gap: 9px 22px; align-items: center; }

  .al-ambiti { padding: clamp(56px,8vw,104px) var(--pad-x) clamp(48px,6vw,80px); }
  .al-ambiti__grid { display: grid; grid-template-columns: repeat(3,1fr); gap: clamp(20px,3vw,48px) clamp(24px,4vw,64px); }
  @media (max-width: 1179px) { .al-ambiti__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 899px)  { .al-ambiti__grid { grid-template-columns: 1fr; } }
  .al-ambito { min-width: 0; padding-top: 20px; border-top: 1px solid rgba(26,29,35,.16); }
  .al-ambito__title { font: 500 clamp(20px,2.2vw,27px)/1.2 var(--font-display); color: var(--dark); margin: 0 0 10px; letter-spacing: -.01em; }
  .al-ambito__desc { font: 400 15px/1.7 var(--font-body); color: var(--grey-600); margin: 0; max-width: 440px; }

  .al-lavori { padding: 0 var(--pad-x) clamp(56px,8vw,96px); }
  .al-h2-mid { font: 500 clamp(28px,4vw,52px)/1.06 var(--font-display); color: var(--dark); margin: 0; letter-spacing: -.015em; }
  .al-works { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: clamp(14px,2vw,28px); }
  .al-works--single { grid-template-columns: minmax(0,480px); }
  @media (max-width: 899px) { .al-works, .al-works--single { grid-template-columns: 1fr; } }
  .prod-nota { font: 400 14px/1.65 var(--font-body); color: var(--grey-500); margin: 22px 0 0; max-width: 640px; }

  .al-case { padding: clamp(64px,9vw,116px) var(--pad-x); }
  .al-case__h2 { font: 500 clamp(28px,4vw,52px)/1.06 var(--font-display); color: var(--offwhite); margin: 0 0 clamp(28px,4vw,48px); letter-spacing: -.015em; max-width: 820px; }
  .al-case__blocks { display: grid; grid-template-columns: repeat(3,1fr); gap: clamp(24px,4vw,64px); align-items: start; margin-bottom: clamp(28px,4vw,48px); }
  @media (max-width: 899px) { .al-case__blocks { grid-template-columns: 1fr; } }
  .al-case__label { font: 600 11px var(--font-mono); letter-spacing: .12em; color: var(--orange); margin: 0 0 12px; }
  .al-case__text { font: 400 15px/1.7 var(--font-body); color: var(--grey-400); margin: 0; }
  .al-case__gallery { display: grid; grid-template-columns: repeat(4,1fr); gap: clamp(12px,1.6vw,20px); }
  @media (max-width: 899px) { .al-case__gallery { grid-template-columns: 1fr 1fr; } }
  .al-case__photo { aspect-ratio: 4 / 3; overflow: hidden; min-width: 0; }
  .al-case__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .al-coord { padding: clamp(64px,9vw,116px) var(--pad-x); }
  .al-coord__head { margin-bottom: clamp(32px,4.5vw,56px); }
  .al-coord__h2 { font: 500 clamp(28px,4vw,52px)/1.06 var(--font-display); color: var(--offwhite); margin: 0; letter-spacing: -.015em; }
  .al-coord__links { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
  @media (max-width: 899px) { .al-coord__links { grid-template-columns: 1fr; } }
  .al-coord__links a {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 20px 0; border-bottom: 1px solid var(--line-light);
    font: 500 clamp(16px,1.8vw,20px) var(--font-display); color: var(--offwhite);
    min-width: 0; min-height: 44px;
  }
  .al-coord__links a:hover { color: var(--orange); }
  .al-coord__links span { color: var(--orange); }

  .al-processo { padding: 0 var(--pad-x) clamp(64px,9vw,116px); }
  .al-processo__h2 { margin-bottom: clamp(32px,4vw,56px); max-width: 680px; }
  .al-steps { grid-template-columns: repeat(4,1fr); }
  @media (max-width: 1179px) { .al-steps { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 899px)  { .al-steps { grid-template-columns: 1fr; } }

  .al-h2 { font: 500 clamp(26px,3.4vw,44px)/1.1 var(--font-display); color: var(--dark); margin: 0 0 clamp(28px,3.5vw,48px); letter-spacing: -.01em; max-width: 720px; }
  .al-perks { display: grid; grid-template-columns: repeat(4,1fr); gap: clamp(20px,3vw,40px); }
  @media (max-width: 1179px) { .al-perks { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 899px)  { .al-perks { grid-template-columns: 1fr; } }
  .vt-perk__num { display: block; font: 700 10.5px var(--font-mono); letter-spacing: .14em; color: var(--accent-text); margin-bottom: 12px; }
  .vt-perk__title { font: 500 clamp(19px,2vw,25px)/1.2 var(--font-display); color: var(--dark); margin: 0 0 10px; letter-spacing: -.01em; }
  .vt-perk__desc { font: 400 14.5px/1.65 var(--font-body); color: var(--grey-600); margin: 0; }

  .al-territorio { padding: clamp(56px,8vw,96px) var(--pad-x); }
  .al-cross { margin-top: clamp(40px,5vw,64px); }
  .vt-cross__h2 { font: 500 clamp(20px,2.4vw,28px)/1.2 var(--font-display); color: var(--offwhite); margin: 0; letter-spacing: -.01em; }
  .split--file { grid-template-columns: minmax(280px,.9fr) minmax(320px,1.1fr); gap: clamp(24px,4vw,72px); align-items: start; }
  @media (max-width: 899px) { .split--file { grid-template-columns: 1fr; } }
  .form-head--wide { max-width: 760px; }

  .wa-band { background: var(--orange); padding: clamp(40px,5.5vw,72px) var(--pad-x); }
  .wa-band__inner { display: flex; flex-wrap: wrap; gap: 24px 48px; align-items: center; justify-content: space-between; }
  .wa-band__h2 { font: 500 clamp(22px,2.8vw,36px)/1.15 var(--font-display); color: var(--dark); margin: 0; letter-spacing: -.01em; }
  .wa-band__text { font: 400 15px/1.6 var(--font-body); color: rgba(26,29,35,.75); margin: 10px 0 0; }
  .wa-band__cta { display: inline-flex; align-items: center; gap: 10px; font: 600 15px var(--font-body); color: var(--offwhite); background: var(--dark); padding: 18px 28px; border-radius: var(--radius); min-height: 44px; transition: transform .15s ease; }
  .wa-band__cta:hover { transform: translateY(-2px); color: var(--offwhite); }
  .wa-band__cta--ghost { background: transparent; color: var(--dark); border: 1px solid rgba(26,29,35,.45); }
  .wa-band__cta--ghost:hover { border-color: var(--dark); color: var(--dark); transform: none; }
</style>
