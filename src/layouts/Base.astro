---
import '../styles/tokens.css';
import '../styles/components.css';
import SEOHead from '../components/SEOHead.astro';
import SkipLink from '../components/SkipLink.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import { seoFor } from '../data/seo.js';

const {
  path,
  ctaHref = '/#contatti',
  ctaLabel = 'Richiedi un preventivo',
  waText = '',
  stickyCtaHref = '/#contatti'
} = Astro.props;

const meta = seoFor(path);
---
<!DOCTYPE html>
<html lang="it">
  <head>
    <SEOHead
      path={path}
      title={meta.title}
      description={meta.description}
      ogImage={meta.ogImage}
      noindex={meta.noindex}
    />
  </head>
  <body>
    <SkipLink />
    <Header current={path} ctaHref={ctaHref} ctaLabel={ctaLabel} />

    <div id="main-content" tabindex="-1"></div>
    <main>
      <slot />
    </main>

    <Footer current={path} />
    <StickyBar waText={waText} ctaHref={stickyCtaHref} />

    <slot name="after" />

    <script>
      import { initNav } from '../scripts/nav.js';
      import { initLeadForm } from '../scripts/lead-form.js';
      import { initLightbox } from '../scripts/lightbox.js';
      import { initFilters } from '../scripts/filters.js';
      initNav();
      initLeadForm();
      initLightbox();
      initFilters();
    </script>
  </body>
</html>
