---
import { site } from '../data/site.js';
const {
  heading,
  text,
  primaryHref = '/#contatti',
  primaryLabel = 'Richiedi un preventivo',
  showCall = true
} = Astro.props;
---
<section class="section section--dark">
  <div class="container cta-block">
    <h2>{heading}</h2>
    <div>
      <p>{text}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={primaryHref}>{primaryLabel}</a>
        {showCall && <a class="btn btn--ghost-dark" href={site.tel.href}>Chiama {site.tel.display}</a>}
      </div>
    </div>
  </div>
</section>
